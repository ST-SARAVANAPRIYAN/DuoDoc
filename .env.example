# IntelliDoc Environment Configuration Template
# Copy this file to .env to override default paths

# Checkpoint Directory where model checkpoints and tokenizer are stored
CHECKPOINT_DIR=./checkpoints

# Explicit Path to Custom Model Checkpoint
CUSTOM_MODEL_PATH=./checkpoints/best_model.pt
TOKENIZER_PATH=./checkpoints/tokenizer.json
VAL_MAP_PATH=./checkpoints/val_map.json

# Foundation VLM Path
# Can be a HuggingFace model ID:
# VLM_MODEL_PATH=Qwen/Qwen2-VL-2B-Instruct
# Or a local directory containing downloaded weights:
# VLM_MODEL_PATH=/home/saravana/models/qwen2-vl-2b-instruct
VLM_MODEL_PATH=Qwen/Qwen2-VL-2B-Instruct

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
